# SunkGuard Environment Configuration

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Guardrails and Concurrency Caps
# Maximum number of external model API calls permitted per session / run
GEMINI_CALL_CAP=100

# Maximum aggregate tokens permitted across all compound agent workflows
GEMINI_TOKEN_CAP=500000

# Simulation defaults
SUNKGUARD_DEFAULT_POLICY=medium
SUNKGUARD_DEFAULT_LOAD=0.50
